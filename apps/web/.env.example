# apps/web local dev env (Next.js auto-loads .env.local in dev)
# Copy this to apps/web/.env.local and fill in values.

# Admin login credentials (Phase 4 — single-user demo auth)
ADMIN_USERNAME=admin
# Generate hash via: pnpm --filter @ai-logist/web gen:admin-password
ADMIN_PASSWORD_HASH=
# 32-byte hex random — generate via: openssl rand -hex 32
AUTH_COOKIE_SECRET=

# Server-Component fetch base (local dev = host-machine API)
API_INTERNAL_URL=http://localhost:3000
